{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.4.0",
  "theme": "gruvbox-dark-hard",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "xhigh",
  "packages": [
    "npm:@cortexkit/pi-magic-context",
    "npm:@cortexkit/aft-pi",
    "npm:pi-hide-providers",
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-context-view",
    "npm:pi-subagents",
    "npm:pi-mini",
    "npm:pi-mcp-adapter",
    "npm:pi-intercom",
    "npm:@tmustier/pi-usage-extension",
    "/w/projects/pi-toolview"
  ],
  "terminal": {
    "showTerminalProgress": false
  },
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "warnings": {
    "anthropicExtraUsage": true
  },
  "quietStartup": true,
  "hideThinkingBlock": false,
  "enableInstallTelemetry": false,
  "enableAnalytics": false,
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "opencode-go/minimax-m3",
    "opencode-go/glm-5.2",
    "opencode-go/hy3",
    "opencode-go/kimi-k2.7-code",
    "opencode-go/longcat-2.0",
    "opencode-go/mimo-v2.5",
    "opencode-go/qwen3.7-plus",
    "opencode-go/muse-spark-1.2-contributor",
    "opencode-go/muse-spark-1.3-contributor",
    "opencode-go/glm-5.3-flash",
    "openai-codex/gpt-6-sol",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6.1-sol",
    "github-copilot/claude-opus-5.5",
    "github-copilot/claude-sonnet-5.5",
    "github-copilot/claude-haiku-5.5"
  ],
  "subagents": {
    "defaultExtensions": [
      "~/.pi/agent/npm/node_modules/@cortexkit/aft-pi/dist/index.js",
      "~/.pi/agent/npm/node_modules/@cortexkit/pi-magic-context/dist/index.js"
    ],
    "agentOverrides": {
      "codex-exec": {
        "disabled": true
      },
      "codex-exec-writer": {
        "disabled": true
      },
      "claude-code": {
        "disabled": true
      },
      "claude-code-writer": {
        "disabled": true
      },
      "cursor-agent": {
        "disabled": true
      },
      "cursor-agent-writer": {
        "disabled": true
      },
      "scout": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "low",
        "inheritGlobalContext": true,
        "inheritSkills": false,
        "skills": [],
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "write",
          "contact_supervisor",
          "bash_status",
          "bash_watch",
          "bash_write",
          "bash_kill",
          "aft_search",
          "aft_outline",
          "aft_zoom",
          "aft_callgraph",
          "aft_inspect",
          "aft_conflicts",
          "ast_grep_search",
          "ctx_search",
          "ctx_expand",
          "ctx_reduce"
        ]
      },
      "worker": {
        "model": "inherit",
        "thinking": "xhigh",
        "inheritGlobalContext": true,
        "inheritSkills": false,
        "skills": [
          "ub-mode",
          "agent-browser",
          "testing",
          "writing-for-agents",
          "reverse-engineer-anything"
        ],
        "subagentOnlyExtensions": [
          "~/.pi/agent/npm/node_modules/pi-mcp-adapter/index.ts"
