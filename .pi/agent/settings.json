          "web_search",
          "fetch_content",
          "get_search_content",
          "source_check",
          "ctx_search",
          "ctx_expand",
          "ctx_reduce",
          "mcp"
        ]
      },
      "evidence-auditor": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "high",
        "inheritGlobalContext": true,
        "inheritSkills": false,
        "skills": ["ck-repowise", "codebase-exploration", "architectural-decisions"],
        "extensions": [
          "~/.pi/agent/npm/node_modules/@cortexkit/aft-pi/dist/index.js",
          "~/.pi/agent/npm/node_modules/@cortexkit/pi-magic-context/dist/index.js",
          "~/.pi/agent/npm/node_modules/pi-web-access/dist/index.js"
        ],
        "tools": [
          "read",
