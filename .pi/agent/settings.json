          "find",
          "ls",
          "contact_supervisor",
          "aft_search",
          "aft_outline",
          "aft_zoom",
          "aft_callgraph",
          "aft_inspect",
          "aft_conflicts",
          "ast_grep_search",
          "web_search",
          "fetch_content",
          "get_search_content",
          "source_check",
          "ctx_search",
          "ctx_expand",
          "ctx_reduce",
          "mcp"
        ]
      }
    }
  },
  "editorPaddingX": 1,
  "outputPad": 1,
  "extensions": [
    "-builtin:mcp",
    "-builtin:codemode"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.47.0",
    "{\"source\":\"npm:pi-context-view\",\"scope\":\"user\"}": "0.8.3",
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.87.0",
