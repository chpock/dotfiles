          "aft_safety",
          "ast_grep_replace",
          "ctx_search",
          "ctx_expand",
          "ctx_reduce",
          "mcp"
        ]
      },
      "reviewer": {
        "model": "inherit",
        "thinking": "max",
        "inheritGlobalContext": true,
        "inheritSkills": false,
        "skills": [
          "grill-for-unknowns",
          "ck-testing",
          "writing-for-agents",
          "codebase-design",
          "ck-repowise",
          "codebase-exploration",
          "architectural-decisions",
          "change-review",
          "code-health",
          "dead-code-cleanup"
        ],
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "watchdog_diff",
          "contact_supervisor",
          "aft_search",
          "aft_outline",
          "aft_zoom",
          "aft_callgraph",
          "aft_inspect",
          "aft_conflicts",
          "ast_grep_search",
          "ctx_search",
          "ctx_expand",
          "ctx_reduce",
          "mcp"
        ]
      },
      "second-opinion": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "max",
        "advertise": true,
        "acceptanceRole": "read-only",
        "systemPromptMode": "replace",
        "inheritProjectContext": true,
        "inheritGlobalContext": true,
        "inheritSkills": false,
        "defaultContext": "fresh",
        "skills": [
          "codebase-design",
          "ck-repowise",
          "codebase-exploration",
          "architectural-decisions",
          "change-review",
          "code-health",
          "dead-code-cleanup"
        ],
        "extensions": [
          "~/.pi/agent/npm/node_modules/pi-web-access/dist/index.js"
        ],
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "web_search",
          "fetch_content",
          "get_search_content",
          "source_check",
          "contact_supervisor",
          "mcp"
        ]
      },
      "oracle": {
        "model": "openai-codex/gpt-6-astra",
