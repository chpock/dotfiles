{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.5.0",
  "theme": "gruvbox-dark-hard",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "xhigh",
  "packages": [
    "npm:@cortexkit/pi-magic-context",
    "npm:@cortexkit/aft-pi",
    "npm:pi-hide-providers",
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-context-view",
    "npm:pi-subagents",
    "npm:pi-mini",
    "npm:pi-mcp-adapter",
    "npm:pi-intercom",
    "npm:@tmustier/pi-usage-extension",
    "/w/projects/pi-toolview",
    "npm:@cortexkit/pi-anthropic-auth@2.4.10"
  ],
  "terminal": {
    "showTerminalProgress": false
  },
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "warnings": {
    "anthropicExtraUsage": true
  },
  "quietStartup": true,
  "hideThinkingBlock": false,
  "enableInstallTelemetry": false,
  "enableAnalytics": false,
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-sol",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6.1-sol",
    "github-copilot/claude-opus-5.5",
    "github-copilot/claude-sonnet-5.5",
    "github-copilot/claude-haiku-5.5",
    "anthropic/claude-opus-5-5",
    "anthropic/claude-sonnet-5-5",
    "anthropic/claude-haiku-5-5",
    "opencode-go/deepseek-v4.1-flash"
  ],
  "subagents": {
    "defaultExtensions": [
      "~/.pi/agent/npm/node_modules/@cortexkit/aft-pi/dist/index.js",
      "~/.pi/agent/npm/node_modules/@cortexkit/pi-magic-context/dist/index.js"
    ],
    "defaultSubagentOnlyExtensions": [
      "~/.pi/agent/npm/node_modules/pi-mcp-adapter/index.ts"
    ],
    "agentOverrides": {
      "codex-exec": {
        "disabled": true
      },
      "codex-exec-writer": {
        "disabled": true
      },
      "claude-code": {
        "disabled": true
      },
      "claude-code-writer": {
        "disabled": true
      },
      "cursor-agent": {
        "disabled": true
      },
      "cursor-agent-writer": {
        "disabled": true
      },
      "scout": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "low",
        "inheritGlobalContext": true,
        "inheritSkills": false,
        "skills": ["ck-repowise", "codebase-exploration"],
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "write",
          "contact_supervisor",
          "bash_status",
          "bash_watch",
          "bash_write",
          "bash_kill",
          "aft_search",
          "aft_outline",
          "aft_zoom",
          "aft_callgraph",
          "aft_inspect",
          "aft_conflicts",
          "ast_grep_search",
          "ctx_search",
          "ctx_expand",
          "ctx_reduce",
          "mcp"
        ]
      },
      "worker": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "max",
        "inheritGlobalContext": true,
        "inheritSkills": false,
        "skills": [
          "agent-browser",
          "ck-testing",
          "writing-for-agents",
          "codebase-design",
          "ck-repowise",
          "codebase-exploration",
          "architectural-decisions",
          "pre-modification-check",
          "change-review",
          "code-health",
          "dead-code-cleanup"
        ],
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "edit",
          "write",
          "contact_supervisor",
          "bash_status",
          "bash_watch",
          "bash_write",
          "bash_kill",
          "aft_search",
          "aft_outline",
          "aft_zoom",
          "aft_callgraph",
          "aft_inspect",
          "aft_conflicts",
          "ast_grep_search",
          "aft_import",
          "aft_move",
          "aft_delete",
          "aft_safety",
          "ast_grep_replace",
          "ctx_search",
          "ctx_expand",
          "ctx_reduce",
          "mcp"
        ]
      },
      "delegate": {
        "description": "Lightweight general executor for bounded tasks with no default reads",
        "model": "openai-codex/gpt-6-luna",
        "thinking": "max",
        "inheritGlobalContext": true,
        "inheritSkills": false,
        "skills": [
          "agent-browser",
          "ck-testing",
          "writing-for-agents",
          "codebase-design",
          "ck-repowise",
          "codebase-exploration",
          "architectural-decisions",
          "pre-modification-check",
          "change-review",
          "code-health",
          "dead-code-cleanup"
        ],
        "tools": [
